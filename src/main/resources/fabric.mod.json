{
  "schemaVersion": 1,
  "id": "gtltagger",
  "version": "${version}",
  "name": "GTL Tiertagger",
  "description": "The official Fabric companion mod for the Global Tierlist (GTL). Shows GTL PvP tiers in the TAB list, nametags, and an in-game HUD, with kit detection and TierTag chat generation.",
  "authors": ["darkboyop"],
  "contact": {
    "homepage": "https://gtltierlist.vercel.app",
    "discord": "https://discord.gg/6Yvgvr8Vdy"
  },
  "license": "ARR",
  "environment": "client",
  "icon": "assets/gtltagger/icon.png",
  "entrypoints": {
    "client": [
      "com.gtltagger.client.GTLTaggerClient"
    ]
  },
  "mixins": [
    "gtltagger.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": ">=1.21.1 <=1.21.7",
    "java": ">=21",
    "fabric-api": "*"
  }
}
