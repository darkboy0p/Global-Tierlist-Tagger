{
  "schemaVersion": 1,
  "id": "gtltagger",
  "version": "${version}",
  "name": "GTLTagger",
  "description": "Shows Global Tierlist (GTL) ranking website tiers in your TAB list, above player nametags, and on a customizable HUD. Includes player search, automatic kit detection, and a TierTag generator.",
  "authors": [
    "darkboyop"
  ],
  "contact": {
    "ranking-website": "https://gtltierlist.vercel.app",
    "discord": "https://discord.gg/E8FPMEHPtv"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.gtltagger.client.GTLTaggerClient"
    ]
  },
  "mixins": [
    "gtltagger.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": ">=1.21.1 <=1.21.7",
    "java": ">=21",
    "fabric-api": "*"
  }
}
