{
  "schemaVersion": 1,
  "id": "gtltagger",
  "version": "${version}",
  "name": "GTLTagger",
  "description": "Generates [:icon:TIER]IGN[:icon:TIER] chat tags for Minecraft PvP tier lists, with TAB display, kit detection, and an in-game HUD.",
  "authors": ["You"],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.gtltagger.client.GTLTaggerClient"
    ]
  },
  "mixins": [
    "gtltagger.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": ">=1.21.1 <=1.21.7",
    "java": ">=21",
    "fabric-api": "*"
  }
}
